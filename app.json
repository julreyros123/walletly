{
  "expo": {
    "name": "cbudget",
    "slug": "cbudget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/walletly-logo.png",
    "scheme": "cbudget",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/walletly-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A2540",
        "foregroundImage": "./assets/images/walletly-logo.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.julreyros123.cbudget",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A2540",
          "android": {
            "image": "./assets/images/walletly-logo.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-google-signin/google-signin",
      "expo-audio",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cdb044d-ef95-4b1a-9a6a-183275403052"
      }
    }
  }
}
