{
  "expo": {
    "name": "Cbudget",
    "slug": "cbudget",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/9cdb044d-ef95-4b1a-9a6a-183275403052",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/walletly_app_icon_1024.png",
    "scheme": "cbudget",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/walletly_app_icon_1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A2540",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.julreyros123.cbudget",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/walletly_app_icon_1024.png"
    },
    "plugins": [
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A2540",
          "android": {
            "image": "./assets/images/walletly_app_icon_1024.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-localization",
      "@react-native-google-signin/google-signin",
      "expo-audio",
      "expo-notifications",
      "expo-asset",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cdb044d-ef95-4b1a-9a6a-183275403052"
      }
    }
  }
}
